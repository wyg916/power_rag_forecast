<script>
    var flag = true;
    var settimeout  = null;
    var time = 11;
    function openReadText(proId,deptId,token,userType,areacode,state){

        $('.noticebg').show();
        if(flag){
            settimeout = setInterval(function(){
                time--;
                if(time == 0){
                    $('.noticebtn ').attr('class','noticebtn');
                    $('.noticebtn ').html("我已阅读告知内容并同意").attr("onclick","noticeRead('"+proId+"','"+deptId+"','"+token+"','"+userType+"','"+state+"');");
                    clearInterval(settimeout);
                    return false;
                }
                $('.noticebtn ').html("("+time+") 我已阅读告知内容并同意");

            },1000)
            flag = false;
        }
    }
    function closeNoticeFn(){
        $('.noticebg').hide();
    }
    function noticeRead(proId,deptId,token,userType,state){
        $('.noticebg').hide();
