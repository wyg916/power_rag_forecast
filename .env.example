# PostgreSQL primary database
# Do not commit real passwords. Example:
# DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/postgres
APP_ENV=development
# 普通业务连接不得使用 postgres、超级用户或迁移身份。
DATABASE_URL=
# 仅供认证、用户、审计和系统设置仓储使用，不得与 DATABASE_URL 相同。
SECURITY_DATABASE_URL=
# 仅供 Alembic/受控维护命令使用，不得注入后端或 Celery 常规进程。
MIGRATION_DATABASE_URL=
DATABASE_PRIMARY=postgresql
# Compatibility fallback is opt-in for legacy import/debug only. Normal development and production keep 0.
DATABASE_ALLOW_LEGACY_FALLBACK=0

# Docker Compose deployment:
# Copy .env.docker.example to .env.docker, fill only placeholders, then run:
# docker compose --env-file .env.docker up -d --build
# Production should use APP_ENV=production, AUTH_REQUIRED=1, DATABASE_ALLOW_LEGACY_FALLBACK=0, TASK_EXECUTION_MODE=celery.
AUTO_MIGRATE=0

# Redis / Celery local runtime
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Docker Desktop Linux context used by the project-local Redis scripts.
PHASE4_DOCKER_CONTEXT=desktop-linux
# The phase-four worker only consumes this isolated, side-effect-free queue.
PHASE4_CELERY_QUEUE=phase4_health
PHASE4_RUNTIME_DIR=.codex_tmp/phase4_runtime
PHASE4_RUNTIME_LOG_DIR=output/runtime_logs/phase4
PHASE4_TEMP_DIR=.codex_tmp/phase4_runtime_tmp

# Optional executable/cache locations. Leave empty to use the project virtual environment and PATH.
PYTHON_EXE=
NODE_HOME=
NPM_EXE=
HF_CACHE_ROOTS=

# Task center execution mode
# auto: development default. Use Celery/Redis when available, otherwise local_thread fallback.
# celery: production recommended. Task creation fails clearly if Celery/Redis is unavailable.
# local_thread: local development fallback only. Production emits a warning if enabled.
TASK_EXECUTION_MODE=auto

# Optional legacy MySQL importer only. These variables are not the application runtime database.
# Leave the password empty unless an operator explicitly runs a legacy migration script.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dianli-yuce
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10

# PJM Data Miner 2
# PJM_SUBSCRIPTION_KEY 可选；为空时默认从 Data Miner 2 公开前端配置自动发现 subscription key。
PJM_SUBSCRIPTION_KEY=your_pjm_subscription_key_here
PJM_AUTO_DISCOVER_SUBSCRIPTION_KEY=1
PJM_SETTINGS_URL=https://dataminer2.pjm.com/config/settings.json
PJM_NODE_ID=34964545
PJM_NODE_NAME=DOM
PJM_REGION=DOM

# Weather / Market
WEATHER_LAT=37.5407
WEATHER_LON=-77.4360
WEATHER_POINT_NAME=Richmond, Virginia
MARKET_TIMEZONE=America/New_York

# LLM / Ollama
LLM_PROVIDER=ollama
MODEL_PROVIDER=ollama
LLM_ROUTER_MODE=auto
LLM_API_MODE=native
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2200
LLM_TIMEOUT=240
LLM_AUTO_PULL=0
START_OLLAMA=0
OLLAMA_WARMUP_CHAT=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODELS=

# DeepSeek API
# Do not commit real API keys. Put the real value only in local .env or server secret manager.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT=120

# Pipeline
ENABLE_ROLLING_BACKTEST=1
PIPELINE_OUTPUT_ROOT=自动化输出
FINAL_OUTPUT_ROOT=全流程预测结果数据存放

# Model learning / fast forecast
ACTIVE_MODEL_ARTIFACT_PATH=
BIAS_CORRECTION_ENABLED=1
BIAS_CORRECTION_MIN_SAMPLES=10
BIAS_CORRECTION_MAX_ADJUSTMENT=10

# Optional webhook URLs
WEWORK_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# Web platform
WEB_BACKEND_HOST=127.0.0.1
WEB_BACKEND_PORT=8000
WEB_FRONTEND_HOST=127.0.0.1
WEB_FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Frontend login gate. Development defaults to 0; production builds default to 1.
VITE_AUTH_REQUIRED=0

# Demo mode keeps APIs usable without login.
# Development: AUTH_REQUIRED=0 keeps header/dev fallback available.
# Production: AUTH_REQUIRED=1 requires Authorization: Bearer <JWT>; X-User/X-Role fallback is disabled.
AUTH_REQUIRED=0
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production must complete the controlled admin bootstrap, then set ADMIN_INITIALIZED=1.
ADMIN_INITIALIZED=0
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# RBAC roles: admin / analyst / viewer / developer
# developer/admin can use debug=true and read AI trace details; viewer cannot trigger long tasks or imports.

# AI assistant
AI_ASSISTANT_DEFAULT_SCENARIO=power_trading
AI_ASSISTANT_DEFAULT_USER_ROLE=trader
AI_ASSISTANT_DEFAULT_ANSWER_STYLE=professional_brief
AI_ASSISTANT_REQUIRE_EVIDENCE=1
AI_ASSISTANT_ALLOW_EXTERNAL_FACTS=0
# Disabled until an operator configures and verifies Ollama or DeepSeek.
AI_ASSISTANT_LLM_ENABLED=0
AI_SHOW_DEBUG_TRACE=0

# RAG / Knowledge retrieval
RAG_ENABLED=0
RAG_EMBEDDING_PROVIDER=disabled
RAG_EMBEDDING_MODEL=disabled
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_EXPECTED_DIM=1024
RAG_EMBEDDING_VERSION=disabled
RAG_EMBEDDING_ALLOW_FALLBACK=0
RAG_EMBEDDING_FALLBACK_PROVIDER=disabled
RAG_FILE_FALLBACK_ENABLED=0
# 可选：接入本地 sentence-transformers/BGE embedding
# RAG_EMBEDDING_PROVIDER=sentence_transformers
# RAG_EMBEDDING_MODEL_PATH=/path/to/bge-large-zh-v1.5
# RAG_EMBEDDING_MODEL_NAME=bge-large-zh-v1.5
# RAG_EMBEDDING_DEVICE=cpu
# RAG_EMBEDDING_BATCH_SIZE=16
# RAG_EMBEDDING_EXPECTED_DIM=1024
# RAG_EMBEDDING_VERSION=bge-large-zh-v1.5-v1
# RAG_EMBEDDING_ALLOW_FALLBACK=0
# RAG_EMBEDDING_FALLBACK_PROVIDER=disabled
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_FILE_FALLBACK_ENABLED=0
RAG_PROFILE=balanced
# RAG performance profiles:
# quality:  RAG_KEYWORD_LIMIT=30, RAG_VECTOR_LIMIT=50, RAG_RERANK_CANDIDATE_LIMIT=20
# balanced: RAG_KEYWORD_LIMIT=25, RAG_VECTOR_LIMIT=40, RAG_RERANK_CANDIDATE_LIMIT=12
# fast:     RAG_KEYWORD_LIMIT=15, RAG_VECTOR_LIMIT=25, RAG_RERANK_CANDIDATE_LIMIT=8
# Explicit limits below override RAG_PROFILE defaults.
RAG_KEYWORD_LIMIT=25
RAG_VECTOR_LIMIT=40
RAG_KEYWORD_TOP_K=25
RAG_VECTOR_TOP_K=40
RAG_VECTOR_SCAN_LIMIT=3000
RAG_RERANK_CANDIDATE_LIMIT=12
RAG_CACHE_ENABLED=1
RAG_CACHE_TTL_SECONDS=600
RAG_QUERY_REWRITE_CACHE_TTL_SECONDS=600
RAG_QUERY_REWRITE_ENABLED=1
RAG_QUERY_EXPANSION_MAX_TERMS=32
RAG_DOMAIN_SYNONYMS_PATH=knowledge_pipeline/domain_synonyms.json
RAG_TITLE_ALIAS_BOOST_ENABLED=1
RAG_CATEGORY_BOOST_ENABLED=1
RAG_DOMAIN_BOOST_MAX=0.18
RAG_IMPORTED_NOTE_PENALTY=0.06
RAG_CORE_DOC_FINAL_BONUS=0.08
RAG_RERANK_ENABLED=1
RAG_RERANK_PROVIDER=local
RAG_RERANK_MODEL=bge-reranker-base
# 可选：接入本地 BGE reranker
# RAG_RERANK_PROVIDER=bge
# RAG_RERANK_MODEL_PATH=/path/to/bge-reranker-v2-m3
# RAG_RERANK_MODEL_NAME=bge-reranker-v2-m3
# RAG_RERANK_DEVICE=cpu
# RAG_RERANK_BATCH_SIZE=8
# RAG_RERANK_MAX_LENGTH=512
# RAG_RERANK_FALLBACK_PROVIDER=heuristic

# Dify phase-1 assistant bridge
# 默认关闭；配置 DIFY_ENABLED=1 且填写 DIFY_API_KEY 后，/api/ai/chat 会优先调用 Dify，失败时回退到本地数据增强助手。
DIFY_ENABLED=0
DIFY_BASE_URL=http://127.0.0.1
DIFY_API_KEY=
DIFY_USER=web_user
DIFY_TIMEOUT=60

# Local Qwen/OpenAI-compatible model gateway
# /api/model-gateway/chat/completions 会按 OpenAI-compatible 协议转发到本地模型服务。
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_FALLBACK_MODELS=
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=120
