# Docker Compose deployment example.
# Copy this file to .env.docker or use it in CI/CD with:
#   docker compose --env-file .env.docker up -d --build
# Do not commit real passwords, API keys, or customer data.

COMPOSE_PROJECT_NAME=power-trading-ai

APP_ENV=production
AUTH_REQUIRED=1
# Replace locally with a cryptographically random value of at least 32 characters.
JWT_SECRET_KEY=replace_with_generated_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set to 1 only after the controlled administrator bootstrap is complete.
ADMIN_INITIALIZED=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
DATABASE_ALLOW_LEGACY_FALLBACK=0
TASK_EXECUTION_MODE=celery
AUTO_MIGRATE=1
WORKER_AUTO_MIGRATE=0

POSTGRES_DB=power_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_generated_postgres_password
POSTGRES_PORT=5433

REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_AUTH_REQUIRED=1

# CORS should list the real frontend origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# LLM provider selection. Leave API keys empty here; put real values only in local .env.docker or secret manager.
LLM_PROVIDER=ollama
MODEL_PROVIDER=ollama
LLM_ROUTER_MODE=auto
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b
LLM_API_KEY=
LLM_AUTO_PULL=0
AI_ASSISTANT_LLM_ENABLED=0

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3:4b

AI_ASSISTANT_REQUIRE_EVIDENCE=1
AI_ASSISTANT_ALLOW_EXTERNAL_FACTS=0

RAG_ENABLED=0
RAG_PROFILE=balanced
RAG_FILE_FALLBACK_ENABLED=0
RAG_EMBEDDING_ALLOW_FALLBACK=0

# RAG remains honestly disabled until the BGE paths below exist and an operator changes RAG_ENABLED=1.
# BGE model weights stay outside the Docker image and are mounted read-only by docker-compose.yml.
BGE_EMBEDDING_MODEL_HOST_PATH=./bge-large-zh-v1.5
BGE_RERANK_MODEL_HOST_PATH=./bge-reranker-v2-m3
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=bge-large-zh-v1.5
RAG_EMBEDDING_MODEL_PATH=/app/models/bge-large-zh-v1.5
RAG_EMBEDDING_MODEL_NAME=bge-large-zh-v1.5
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_FALLBACK_PROVIDER=disabled
RAG_RERANK_ENABLED=0
RAG_RERANK_PROVIDER=bge
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_RERANK_MODEL_PATH=/app/models/bge-reranker-v2-m3
RAG_RERANK_MODEL_NAME=bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_FALLBACK_PROVIDER=disabled

# Optional Ollama service profile:
# docker compose --env-file .env.docker --profile ollama up -d --build
OLLAMA_PORT=11434
